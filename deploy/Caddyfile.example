# Caddy (https://caddyserver.com): HTTPS для панели. Сертификаты Let's Encrypt — автоматически (нужен свободный 80/443).
# Панель слушает только 127.0.0.1:21114 и доверяет X-Forwarded-For только от 127.0.0.1.

rds.example.com {
	reverse_proxy 127.0.0.1:21114
}

# Страница установки. Если она за Cloudflare (оранжевое облако) — передаём настоящий IP посетителя,
# но только для запросов, пришедших с адресов Cloudflare (https://www.cloudflare.com/ips/).
rd.example.com {
	@cf remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22
	handle @cf {
		reverse_proxy 127.0.0.1:21114 {
			header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:21114
	}
}
