# Скопируйте в .env (или запустите ./install.sh — он сам заполнит секреты). Файл .env — chmod 600, в git не попадает.

# Имя ID-сервера/ретранслятора для клиентов RustDesk. DNS A-запись на этот сервер, БЕЗ прокси Cloudflare
# (клиенты ходят на 21115-21119 напрямую).
RDS_HOST=rds.example.com
# Админка панели (HTTPS через обратный прокси). Обычно то же имя, что RDS_HOST.
ADMIN_HOST=rds.example.com
# Страница установки клиентов (exe / dmg / deb, скрипты). Может быть за Cloudflare.
CLIENT_HOST=rd.example.com

# Адрес API для клиентов RustDesk и агентов (api-server). Пусто — https://ADMIN_HOST.
# Если 443 на сервере занят и админка живёт на другом порту (https://rds.example.com:8444), а CLIENT_HOST
# идёт через Cloudflare с переадресацией на этот порт (Origin Rule) — укажите https://CLIENT_HOST.
# После смены агенты сами перепрописывают api-server в RustDesk (не чаще раза в сутки).
API_URL=

# Первый администратор (создаётся, только пока в базе нет пользователей). Потом пароль меняется в панели.
ADMIN_USER=admin
ADMIN_PASSWORD=

# Секреты: длинные случайные строки (install.sh генерирует сам).
SECRET_KEY=
# Токен регистрации ПК из установщиков (он попадает в публичные скрипты; после привязки у каждого ПК свой ключ).
REG_TOKEN=
PG_PASSWORD=
REDIS_PASSWORD=

# N — P2P, если получится, иначе ретранслятор; Y — всегда через ретранслятор (клиенты за CGNAT/строгим NAT).
ALWAYS_USE_RELAY=N

# Необязательно: HTTP-прокси для скачивания релизов RustDesk с GitHub, если у сервера нет прямого доступа.
# Должен быть доступен как localhost хоста (network_mode: host), например http://127.0.0.1:3128
PROXY_URL=

# 1 — отдавать клиентам ID@сервер?key=… (нужно только со стандартным hbbs без обмена ключами)
CLIENT_SPECIAL_IDS=0

# Образы (по умолчанию — с Docker Hub). Свои сборки: docker build -t ... panel/ и hbbs-kx/
#PANEL_IMAGE=scposs/rds-panel:1.0.2
#HBBS_IMAGE=scposs/rds-hbbs-kx:1.1.16-kx1
